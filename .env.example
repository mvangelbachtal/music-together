# Public URL used in guest, kiosk, and host links.
# For local development, keep this as localhost.
PUBLIC_BASE_URL=http://localhost:8000

# Published image tag used by compose.yml.
IMAGE_TAG=latest

# YouTube Data API v3 key. Enables search; URL submission works without it.
YOUTUBE_API_KEY=

# Use community SponsorBlock intro/outro timestamps when available.
SPONSORBLOCK_ENABLED=1
# Categories to skip. Keep 'hook' and 'chapter' out unless explicitly wanted.
SPONSORBLOCK_CATEGORIES=sponsor,selfpromo,interaction,intro,outro,preview,filler,music_offtopic

# Generic OIDC/OAuth2 provider credentials, for example Authentik.
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTHORIZATION_URL=https://auth.example.com/application/o/authorize/
OIDC_TOKEN_URL=https://auth.example.com/application/o/token/
OIDC_USERINFO_URL=https://auth.example.com/application/o/userinfo/

# Must exactly match a redirect URI registered in Google Cloud Console.
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback

# Set to 1 to require Google login before creating sessions.
# Keep 0 for local development without OAuth credentials.
OIDC_SCOPES=openid email profile
REQUIRE_OIDC_AUTH=0

# Default browser supplying playback audio for new sessions: host or kiosk.
# The session creation toggle can override this per session.
PLAYBACK_OWNER=host
